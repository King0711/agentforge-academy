# Copy this file to .env and paste your own key after the = sign.
# Get your key from your dashboard: Credits -> Copy my AI Builder key
# Never commit .env or share this key. It spends your credits.

SDT_API_KEY=sdt_live_paste_your_own_key_here

# Google Calendar setup (see README Build 2) is NOT done through this
# file. It needs two separate files sitting next to calendar_client.py:
#
#   credentials.json  - downloaded from Google Cloud Console (Build 1).
#                        This is Google's OAuth client secret for YOUR
#                        Google Cloud project, not an AI key - it never
#                        touches sdt_ai.py or your AI Builder credits.
#   token.json         - created automatically the first time you run
#                        calendar_client.py (or main.py) and you approve
#                        the login screen. Delete it if you ever need to
#                        log in again (e.g. you revoked access, or you
#                        want to switch Google accounts).
#
# Keep both out of version control the same way you keep .env out of it -
# they grant read access to your real Google Calendar.
