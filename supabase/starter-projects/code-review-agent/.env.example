# Copy this file to .env and pick ONE of the two options below.
# Never commit .env or share these keys - each one is billed to your own account.

# OPTION 1: free Gemini key - get one at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=paste_your_own_key_here

# OPTION 2: your own Claude/Anthropic key (needs billing set up) - get one at
# https://console.anthropic.com/settings/keys. Comment OPTION 1 out above,
# uncomment these two lines instead.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=paste_your_own_key_here

# GitHub App setup (see Build 1) - the App ID is shown on your app's
# settings page. WEBHOOK_SECRET is whatever random string you set as the
# app's webhook secret when you created it.
GITHUB_APP_ID=paste_your_app_id_here
WEBHOOK_SECRET=paste_your_own_webhook_secret_here

# private-key.pem (downloaded from your GitHub App's settings page) is
# NOT set here - it needs to sit next to github_client.py as an actual
# file, since it's a multi-line PEM key, not a single env value.
