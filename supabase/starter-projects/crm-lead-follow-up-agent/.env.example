# Copy this file to .env and pick ONE of the two options below.
# Never commit .env or share these keys - each one is billed to your own account.

# OPTION 1: free Gemini key - get one at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=paste_your_own_key_here

# OPTION 2: your own Claude/Anthropic key (needs billing set up) - get one at
# https://console.anthropic.com/settings/keys. Comment OPTION 1 out above,
# uncomment these two lines instead.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=paste_your_own_key_here

# HubSpot - create a Private App at Settings > Integrations > Private Apps
# with contacts + tasks read/write scopes, then copy its token here.
HUBSPOT_TOKEN=pat-paste_your_own_token_here

# Slack - optional. Only needed if you want a ping when drafts are ready.
# Create an Incoming Webhook at api.slack.com/apps.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/paste/your/webhook

# Gmail / Google Cloud setup is NOT done through this file. It needs
# credentials.json (downloaded from Google Cloud Console) sitting next to
# gmail_draft.py, plus a token.json that's created automatically the
# first time you log in.
