# Copy this file to .env and paste your own key after the = sign.
# Get a free key at https://aistudio.google.com/apikey (no card required)
# Never commit .env or share this key.

GEMINI_API_KEY=paste_your_own_key_here

# Gmail / Google Cloud setup (see README Build 2) is NOT done through this
# file. It needs two separate files sitting next to gmail_client.py:
#
#   credentials.json  - downloaded from Google Cloud Console (Build 2).
#                        This is Google's OAuth client secret for YOUR
#                        Google Cloud project, not an AI key - it never
#                        touches sdt_ai.py or your Gemini key.
#   token.json         - created automatically the first time you run
#                        gmail_client.py and you approve the login screen.
#                        Delete it if you ever need to log in again.
#
# Keep both out of version control the same way you keep .env out of it -
# they grant access to your real Gmail account.
