# Copy this file to .env and pick ONE of the two options below.
# Never commit .env or share these keys - each one is billed to your own account.

# OPTION 1: free Gemini key - get one at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=paste_your_own_key_here

# OPTION 2: your own Claude/Anthropic key (needs billing set up) - get one at
# https://console.anthropic.com/settings/keys. Comment OPTION 1 out above,
# uncomment these two lines instead.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=paste_your_own_key_here

# Twilio credentials - only needed if you use the Twilio Python SDK to
# manage your WhatsApp sender from code (e.g. sending a message that
# ISN'T a reply to an incoming one). The webhook in app.py does not need
# these: Twilio calls YOUR server to deliver a message, so receiving one
# never requires your server to authenticate back to Twilio.
# Find both values on your Twilio Console dashboard (twilio.com/console).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
