# Copy this file to .env and paste your own key after the = sign.
# Get a free key at https://aistudio.google.com/apikey (no card required)
# Never commit .env or share this key.

GEMINI_API_KEY=paste_your_own_key_here

# Twilio credentials - only needed if you use the Twilio Python SDK to
# manage your WhatsApp sender from code (e.g. sending a message that
# ISN'T a reply to an incoming one). The webhook in app.py does not need
# these: Twilio calls YOUR server to deliver a message, so receiving one
# never requires your server to authenticate back to Twilio.
# Find both values on your Twilio Console dashboard (twilio.com/console).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
