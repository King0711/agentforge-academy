# Copy this file to .env and paste your own key after the = sign.
# Get your key from your dashboard: Credits -> Copy my AI Builder key
# Never commit .env or share this key. It spends your credits.

SDT_API_KEY=sdt_live_paste_your_own_key_here

# Only needed once you're ready to send real leads into HubSpot (Build 3).
# In HubSpot: Settings -> Integrations -> Private Apps -> create an app
# with contacts + tasks read/write scopes, then copy its access token here.
# HUBSPOT_API_KEY=pat-paste_your_private_app_token_here
